{
  "name": "la-garza",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-seo.mjs",
    "preview": "vite preview",
    "test": "playwright test",
    "test:preview": "VITE_CATALOG_SOURCE=local npm run build && playwright test --config=playwright.preview.config.js",
    "check": "npm run build && npm test && playwright test --config=playwright.preview.config.js",
    "db:status": "supabase migration list --linked",
    "db:push:dry": "supabase db push --linked --dry-run",
    "db:push": "supabase db push --linked",
    "migrate:catalog": "node scripts/migrate-catalog.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.111.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^6.0.0",
    "supabase": "^2.111.0",
    "vite": "^8.0.0"
  }
}
